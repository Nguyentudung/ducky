import { Theme } from "../theme/tokens.slint";
import { ProblemItem, UiStrings } from "../types.slint";
import { Button, Choice, Field, Icon, SectionTitle } from "../components/primitives.slint";
import { ProblemRow } from "../components/problem-row.slint";
import { ScrollView } from "std-widgets.slint";

export component ProblemsPage inherits Rectangle {
    in property <UiStrings> strings;
    in property <[ProblemItem]> problems;
    in property <string> search; in property <string> status_filter; in property <string> difficulty_filter; in property <string> language_filter; in property <string> platform_filter; in property <string> tag_filter; in property <string> sort_label;
    callback new_problem; callback search_changed(string); callback status_changed(string); callback difficulty_changed(string); callback language_changed(string); callback platform_changed(string); callback tag_changed(string); callback cycle_sort; callback open_problem(int);
    background: Theme.background;
    ScrollView { VerticalLayout { x: 36px; y: 30px; width: parent.width - 72px; spacing: 20px;
        HorizontalLayout { height: 55px; SectionTitle { eyebrow: root.problems.length + ""; title: root.strings.problems_title; vertical-stretch: 1; } Button { text: root.strings.new_problem; icon: "plus"; kind: "primary"; width: 136px; clicked => root.new_problem(); } }
        Rectangle { height: 157px; background: Theme.surface; border-radius: Theme.radius-md; border-width: 0px;
            VerticalLayout { padding: 16px; spacing: 8px;
                HorizontalLayout { height: 38px; spacing: 9px; Rectangle { width: 38px; height: 38px; border-radius: Theme.radius-sm; background: Theme.field; Icon { name: "search"; ink: Theme.text-muted; width: 18px; height: 18px; x: 10px; y: 10px; } } Field { text: root.search; placeholder: root.strings.search_placeholder; vertical-stretch: 1; edited(value) => root.search_changed(value); } Button { text: root.sort_label; icon: "more"; kind: "ghost"; width: 140px; clicked => root.cycle_sort(); } }
                HorizontalLayout { height: 30px; spacing: 6px;
                    Text { text: root.strings.filter_status; color: Theme.text-muted; font-size: 11px; width: 53px; vertical-alignment: center; }
                    Choice { text: root.strings.all; selected: root.status_filter == ""; width: 48px; clicked => root.status_changed(""); } Choice { text: root.strings.status_not_started; selected: root.status_filter == "not_started"; width: 89px; clicked => root.status_changed("not_started"); } Choice { text: root.strings.status_in_progress; selected: root.status_filter == "in_progress"; width: 86px; clicked => root.status_changed("in_progress"); } Choice { text: root.strings.status_solved; selected: root.status_filter == "solved"; width: 58px; clicked => root.status_changed("solved"); } Choice { text: root.strings.status_review; selected: root.status_filter == "review"; width: 58px; clicked => root.status_changed("review"); }
                }
                HorizontalLayout { height: 30px; spacing: 6px;
                    Text { text: root.strings.filter_difficulty; color: Theme.text-muted; font-size: 11px; width: 53px; vertical-alignment: center; }
                    Choice { text: root.strings.all; selected: root.difficulty_filter == ""; width: 48px; clicked => root.difficulty_changed(""); } Choice { text: root.strings.difficulty_easy; selected: root.difficulty_filter == "easy"; width: 58px; clicked => root.difficulty_changed("easy"); } Choice { text: root.strings.difficulty_medium; selected: root.difficulty_filter == "medium"; width: 72px; clicked => root.difficulty_changed("medium"); } Choice { text: root.strings.difficulty_hard; selected: root.difficulty_filter == "hard"; width: 58px; clicked => root.difficulty_changed("hard"); } Choice { text: root.strings.difficulty_custom; selected: root.difficulty_filter == "custom"; width: 67px; clicked => root.difficulty_changed("custom"); }
                    Text { text: root.strings.filter_language; color: Theme.text-muted; font-size: 11px; width: 62px; vertical-alignment: center; }
                    Choice { text: "C"; selected: root.language_filter == "c"; width: 35px; clicked => root.language_changed(root.language_filter == "c" ? "" : "c"); } Choice { text: "C++"; selected: root.language_filter == "cpp"; width: 43px; clicked => root.language_changed(root.language_filter == "cpp" ? "" : "cpp"); } Choice { text: "Rust"; selected: root.language_filter == "rust"; width: 52px; clicked => root.language_changed(root.language_filter == "rust" ? "" : "rust"); } Choice { text: "Python"; selected: root.language_filter == "python"; width: 61px; clicked => root.language_changed(root.language_filter == "python" ? "" : "python"); } Choice { text: "Java"; selected: root.language_filter == "java"; width: 51px; clicked => root.language_changed(root.language_filter == "java" ? "" : "java"); }
                }
                HorizontalLayout { height: 30px; spacing: 8px; Text { text: root.strings.filter_platform; color: Theme.text-muted; font-size: 11px; width: 53px; vertical-alignment: center; } Field { text: root.platform_filter; placeholder: root.strings.filter_platform; width: 160px; edited(value) => root.platform_changed(value); } Text { text: root.strings.filter_tags; color: Theme.text-muted; font-size: 11px; width: 35px; vertical-alignment: center; } Field { text: root.tag_filter; placeholder: root.strings.filter_tags; width: 130px; edited(value) => root.tag_changed(value); } }
            }
        }
        if root.problems.length == 0 : Rectangle { height: 300px; border-radius: Theme.radius-lg; background: Theme.surface; border-width: 0px; VerticalLayout { alignment: center; spacing: 10px; Icon { name: root.search != "" || root.status_filter != "" || root.difficulty_filter != "" || root.language_filter != "" || root.platform_filter != "" || root.tag_filter != "" ? "search" : "problems"; ink: Theme.accent; width: 34px; height: 34px; } Text { text: root.search != "" || root.status_filter != "" || root.difficulty_filter != "" || root.language_filter != "" || root.platform_filter != "" || root.tag_filter != "" ? root.strings.no_results_title : root.strings.problems_empty_title; color: Theme.text; font-size: 19px; font-weight: 700; horizontal-alignment: center; } Text { text: root.search != "" || root.status_filter != "" || root.difficulty_filter != "" || root.language_filter != "" || root.platform_filter != "" || root.tag_filter != "" ? root.strings.no_results_description : root.strings.problems_empty_description; color: Theme.text-secondary; font-size: 13px; horizontal-alignment: center; } Button { visible: root.search == "" && root.status_filter == "" && root.difficulty_filter == "" && root.language_filter == "" && root.platform_filter == "" && root.tag_filter == ""; text: root.strings.new_problem; icon: "plus"; kind: "primary"; clicked => root.new_problem(); } } }
        if root.problems.length > 0 : VerticalLayout { spacing: 7px; for item in root.problems : ProblemRow { problem: item; clicked(id) => root.open_problem(id); } }
    } }
}
