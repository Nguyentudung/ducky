import { Theme } from "theme/tokens.slint";
import { ProblemItem, UiStrings } from "types.slint";
import { Button, Icon, NavItem } from "components/primitives.slint";
import { HomePage } from "pages/home.slint";
import { ProblemsPage } from "pages/problems.slint";
import { RecentPage } from "pages/recent.slint";
import { SettingsPage } from "pages/settings.slint";
import { ProblemForm, ProblemDetail, ConfirmDialog } from "dialogs.slint";
export { Theme } from "theme/tokens.slint";

export component AppWindow inherits Window {
    title: "Ducky";
    width: 1120px;
    height: 760px;

    in-out property <UiStrings> strings;
    in-out property <string> page: "home";
    in-out property <int> total; in-out property <int> solved; in-out property <int> in_progress; in-out property <int> not_started;
    in-out property <[ProblemItem]> problems; in-out property <[ProblemItem]> recent; in-out property <[ProblemItem]> modified;
    in-out property <string> search; in-out property <string> status_filter; in-out property <string> difficulty_filter; in-out property <string> language_filter; in-out property <string> platform_filter; in-out property <string> tag_filter; in-out property <string> sort_label;
    in-out property <string> theme_value; in-out property <string> language_value; in-out property <string> workspace_value; in-out property <string> default_language_value; in-out property <string> default_difficulty_value;
    in-out property <bool> show_form: false; in-out property <bool> form_editing: false; in-out property <bool> show_detail: false; in-out property <bool> show_confirm_delete: false; in-out property <bool> show_confirm_clear: false;
    in-out property <ProblemItem> selected; in-out property <string> selected_source_files;
    in-out property <string> form_title; in-out property <string> form_identifier; in-out property <string> form_platform; in-out property <string> form_url; in-out property <string> form_tags; in-out property <string> form_description; in-out property <string> form_notes; in-out property <string> form_workspace; in-out property <string> form_difficulty; in-out property <string> form_status; in-out property <string> form_template;
    in-out property <bool> lang_c; in-out property <bool> lang_cpp; in-out property <bool> lang_rust; in-out property <bool> lang_python; in-out property <bool> lang_java;
    in-out property <string> notice; in-out property <bool> notice_error;

    callback navigate(string); callback new_problem; callback edit_problem; callback submit_problem; callback cancel_form; callback open_problem(int); callback delete_problem; callback confirm_delete; callback cancel_delete; callback clear_recent; callback confirm_clear; callback cancel_clear;
    callback search_changed(string); callback status_filter_changed(string); callback difficulty_filter_changed(string); callback language_filter_changed(string); callback platform_filter_changed(string); callback tag_filter_changed(string); callback cycle_sort;
    callback theme_changed(string); callback language_changed(string); callback browse_workspace; callback open_workspace; callback default_language_changed(string); callback default_difficulty_changed(string); callback open_problem_workspace; callback open_problem_url; callback problem_status_changed(string);

    background: Theme.background;
    // Keep common actions available without taking over native text-editing keys.
    forward-focus: keyboard;
    keyboard := FocusScope {
    width: parent.width;
    height: parent.height;
    KeyBinding {
        keys: @keys(Escape);
        activated => {
            root.show_form = false;
            root.show_detail = false;
            root.show_confirm_delete = false;
            root.show_confirm_clear = false;
        }
    }
    KeyBinding { keys: @keys(Control + "n"); activated => { root.new_problem(); } }
    HorizontalLayout {
        Rectangle { width: 232px; background: Theme.sidebar; border-width: 0px; border-color: transparent;
            VerticalLayout { padding-top: 22px; padding-left: 14px; padding-right: 14px; padding-bottom: 14px; spacing: 4px;
                HorizontalLayout { height: 46px; spacing: 10px; padding-left: 8px; Rectangle { width: 30px; height: 30px; border-radius: 10px; background: Theme.accent; Text { text: "D"; color: Theme.text-on-accent; font-size: 16px; font-weight: 750; horizontal-alignment: center; vertical-alignment: center; } } Text { text: root.strings.app_name; color: Theme.text; font-size: 18px; font-weight: 750; vertical-alignment: center; } }
                Rectangle { height: 17px; }
                NavItem { label: root.strings.nav_home; icon: "home"; active: root.page == "home"; clicked => root.navigate("home"); }
                NavItem { label: root.strings.nav_problems; icon: "problems"; active: root.page == "problems"; clicked => root.navigate("problems"); }
                NavItem { label: root.strings.nav_recent; icon: "recent"; active: root.page == "recent"; clicked => root.navigate("recent"); }
                Rectangle { vertical-stretch: 1; }
                Rectangle { height: 1px; background: Theme.separator; }
                NavItem { label: root.strings.nav_settings; icon: "settings"; active: root.page == "settings"; clicked => root.navigate("settings"); }
            }
        }
        Rectangle { width: 1px; background: Theme.separator; }
        Rectangle { horizontal-stretch: 1; background: Theme.background;
            HomePage { visible: root.page == "home"; strings: root.strings; total: root.total; solved: root.solved; in_progress: root.in_progress; not_started: root.not_started; recent: root.recent; modified: root.modified; new_problem => root.new_problem(); browse_problems => root.navigate("problems"); open_workspace => root.open_workspace(); show_recent => root.navigate("recent"); open_problem(id) => root.open_problem(id); }
            ProblemsPage { visible: root.page == "problems"; strings: root.strings; problems: root.problems; search: root.search; status_filter: root.status_filter; difficulty_filter: root.difficulty_filter; language_filter: root.language_filter; platform_filter: root.platform_filter; tag_filter: root.tag_filter; sort_label: root.sort_label; new_problem => root.new_problem(); search_changed(value) => root.search_changed(value); status_changed(value) => root.status_filter_changed(value); difficulty_changed(value) => root.difficulty_filter_changed(value); language_changed(value) => root.language_filter_changed(value); platform_changed(value) => root.platform_filter_changed(value); tag_changed(value) => root.tag_filter_changed(value); cycle_sort => root.cycle_sort(); open_problem(id) => root.open_problem(id); }
            RecentPage { visible: root.page == "recent"; strings: root.strings; items: root.recent; clear => root.clear_recent(); browse => root.navigate("problems"); open_problem(id) => root.open_problem(id); }
            SettingsPage { visible: root.page == "settings"; strings: root.strings; theme_value: root.theme_value; language_value: root.language_value; workspace_value: root.workspace_value; default_language_value: root.default_language_value; default_difficulty_value: root.default_difficulty_value; theme_changed(value) => root.theme_changed(value); language_changed(value) => root.language_changed(value); browse_workspace => root.browse_workspace(); open_workspace => root.open_workspace(); default_language_changed(value) => root.default_language_changed(value); default_difficulty_changed(value) => root.default_difficulty_changed(value); }
            Rectangle { visible: root.notice != ""; x: parent.width - self.width - 24px; y: 20px; width: 330px; height: 44px; border-radius: Theme.radius-md; background: root.notice_error ? Theme.danger-soft : Theme.surface-raised; border-width: 1px; border-color: root.notice_error ? Theme.danger.transparentize(0.35) : Theme.border; HorizontalLayout { padding-left: 12px; padding-right: 12px; spacing: 8px; Icon { name: root.notice_error ? "close" : "check"; ink: root.notice_error ? Theme.danger : Theme.success; width: 18px; height: 18px; } Text { text: root.notice; color: Theme.text; font-size: 12px; vertical-alignment: center; overflow: elide; } } }
        }
    }
    if root.show_form : ProblemForm { strings: root.strings; editing: root.form_editing; form_title <=> root.form_title; form_identifier <=> root.form_identifier; form_platform <=> root.form_platform; form_url <=> root.form_url; form_tags <=> root.form_tags; form_description <=> root.form_description; form_notes <=> root.form_notes; form_workspace <=> root.form_workspace; form_difficulty <=> root.form_difficulty; form_status <=> root.form_status; form_template <=> root.form_template; lang_c <=> root.lang_c; lang_cpp <=> root.lang_cpp; lang_rust <=> root.lang_rust; lang_python <=> root.lang_python; lang_java <=> root.lang_java; close => root.cancel_form(); submit => root.submit_problem(); browse_workspace => root.browse_workspace(); }
    if root.show_detail : ProblemDetail { strings: root.strings; problem: root.selected; source_files: root.selected_source_files; close => { root.show_detail = false; } edit => root.edit_problem(); delete => root.delete_problem(); open_workspace => root.open_problem_workspace(); open_url => root.open_problem_url(); status_changed(value) => root.problem_status_changed(value); }
    if root.show_confirm_delete : ConfirmDialog { strings: root.strings; title: root.strings.confirm_delete; body: root.strings.confirm_delete_body; cancel => root.cancel_delete(); confirm => root.confirm_delete(); }
    if root.show_confirm_clear : ConfirmDialog { strings: root.strings; title: root.strings.confirm_clear; body: root.strings.confirm_clear_body; cancel => root.cancel_clear(); confirm => root.confirm_clear(); }
    }
}
