import { Theme } from "../theme/tokens.slint";

// One quiet 24px outline icon family, painted by Slint instead of emoji glyphs.
export component Icon inherits Rectangle {
    in property <string> name;
    in property <color> ink: Theme.text-secondary;
    background: transparent;
    Path {
        width: parent.width; height: parent.height; viewbox-width: 24; viewbox-height: 24;
        commands: root.name == "home" ? "M 3 11 L 12 3 L 21 11 M 5 10 V 21 H 19 V 10 M 9 21 V 15 H 15 V 21" : root.name == "problems" ? "M 8 6 H 21 M 8 12 H 21 M 8 18 H 21 M 3 6 H 3.1 M 3 12 H 3.1 M 3 18 H 3.1" : root.name == "recent" ? "M 3 12 A 9 9 0 1 1 6 18 M 3 4 V 9 H 8 M 12 7 V 12 L 16 14" : root.name == "settings" ? "M 12 8 A 4 4 0 1 1 12 16 A 4 4 0 1 1 12 8 M 12 3 V 5 M 12 19 V 21 M 3 12 H 5 M 19 12 H 21 M 5.6 5.6 L 7 7 M 17 17 L 18.4 18.4 M 18.4 5.6 L 17 7 M 7 17 L 5.6 18.4" : root.name == "plus" ? "M 12 5 V 19 M 5 12 H 19" : root.name == "folder" ? "M 3 7 H 9 L 11 9 H 21 V 19 H 3 Z" : root.name == "search" ? "M 11 4 A 7 7 0 1 1 11 18 A 7 7 0 1 1 11 4 M 16 16 L 21 21" : root.name == "arrow" ? "M 9 5 L 16 12 L 9 19" : root.name == "close" ? "M 5 5 L 19 19 M 19 5 L 5 19" : root.name == "more" ? "M 5 12 H 5.1 M 12 12 H 12.1 M 19 12 H 19.1" : root.name == "check" ? "M 4 12 L 10 18 L 20 6" : root.name == "spark" ? "M 12 2 L 14 9 L 21 12 L 14 15 L 12 22 L 10 15 L 3 12 L 10 9 Z" : "M 12 12 H 12.1";
        stroke: root.ink; stroke-width: 1.8px; stroke-line-cap: round; stroke-line-join: round; fill: transparent;
    }
}

export component Button inherits Rectangle {
    in property <string> text;
    in property <string> kind: "secondary"; // primary, secondary, ghost, danger
    in property <bool> enabled: true;
    in property <string> icon;
    callback clicked;
    height: Theme.control-height; min-width: 84px; border-radius: Theme.radius-md;
    background: !enabled ? Theme.surface-hover : kind == "primary" ? (area.pressed ? Theme.accent-hover : area.has-hover ? Theme.accent-hover : Theme.accent) : kind == "danger" ? (area.pressed ? Theme.danger.darker(0.10) : Theme.danger) : kind == "ghost" ? (area.pressed || area.has-hover ? Theme.surface-hover : transparent) : (area.pressed ? Theme.surface-hover : area.has-hover ? Theme.field : Theme.surface);
    border-color: kind == "secondary" ? Theme.border : transparent; border-width: kind == "secondary" ? 1px : 0px;
    opacity: enabled ? 1 : 0.72;
    HorizontalLayout { padding-left: 13px; padding-right: 13px; spacing: 7px; alignment: center;
        Icon { visible: root.icon != ""; name: root.icon; width: 16px; height: 16px; ink: root.kind == "primary" || root.kind == "danger" ? Theme.text-on-accent : Theme.text-secondary; }
        Text { text: root.text; color: root.kind == "primary" || root.kind == "danger" ? Theme.text-on-accent : Theme.text; font-size: 13px; font-weight: 650; vertical-alignment: center; }
    }
    area := TouchArea { enabled: root.enabled; clicked => root.clicked(); }
}

export component NavItem inherits Rectangle {
    in property <string> label; in property <string> icon; in property <bool> active; callback clicked;
    height: 42px; border-radius: Theme.radius-md;
    background: active ? Theme.accent-soft : area.has-hover ? Theme.surface-hover : transparent;
    HorizontalLayout { padding-left: 12px; padding-right: 12px; spacing: 11px;
        Rectangle { visible: root.active; width: 3px; height: 18px; border-radius: 2px; background: Theme.accent; }
        Icon { name: root.icon; width: 18px; height: 18px; ink: root.active ? Theme.accent : Theme.text-secondary; }
        Text { text: root.label; color: root.active ? Theme.text : Theme.text-secondary; font-size: 13px; font-weight: root.active ? 650 : 520; vertical-alignment: center; }
    }
    area := TouchArea { clicked => root.clicked(); }
}

export component Tag inherits Rectangle {
    in property <string> text; in property <color> ink: Theme.text-secondary; in property <color> fill: Theme.field;
    height: 23px; border-radius: Theme.radius-sm; background: fill;
    Text { text: root.text; color: root.ink; font-size: 11px; font-weight: 620; horizontal-alignment: center; vertical-alignment: center; }
}

export component Field inherits Rectangle {
    in-out property <string> text; in property <string> placeholder; in property <bool> multiline: false; callback edited(string);
    height: multiline ? 78px : Theme.control-height; border-radius: Theme.radius-sm; background: input.has-focus ? Theme.surface : Theme.field;
    border-color: input.has-focus ? Theme.focus : transparent; border-width: input.has-focus ? 2px : 1px;
    input := TextInput { x: 11px; y: root.multiline ? 9px : 7px; width: parent.width - 22px; height: parent.height - 14px; text <=> root.text; color: Theme.text; font-size: 13px; single-line: !root.multiline; vertical-alignment: root.multiline ? top : center; edited => root.edited(self.text); }
    Text { visible: root.text == "" && !input.has-focus; text: root.placeholder; x: 12px; y: root.multiline ? 10px : 0px; height: parent.height; color: Theme.text-muted; font-size: 13px; vertical-alignment: root.multiline ? top : center; }
}

// Used for filters, languages, and compact segmented controls.
export component Choice inherits Rectangle {
    in property <string> text; in property <bool> selected; callback clicked;
    height: 30px; border-radius: Theme.radius-sm; background: selected ? Theme.accent-soft : area.has-hover ? Theme.surface-hover : transparent;
    border-width: selected ? 1px : 0px; border-color: selected ? Theme.accent.transparentize(0.42) : transparent;
    Text { text: root.text; color: root.selected ? Theme.accent : Theme.text-secondary; font-size: 11px; font-weight: root.selected ? 650 : 520; horizontal-alignment: center; vertical-alignment: center; }
    area := TouchArea { clicked => root.clicked(); }
}

export component SectionTitle inherits VerticalLayout {
    in property <string> eyebrow; in property <string> title; in property <string> detail: "";
    spacing: 3px;
    Text { visible: root.eyebrow != ""; text: root.eyebrow; color: Theme.text-muted; font-size: 11px; font-weight: 650; }
    Text { text: root.title; color: Theme.text; font-size: 26px; font-weight: 720; }
    Text { visible: root.detail != ""; text: root.detail; color: Theme.text-secondary; font-size: 13px; }
}
