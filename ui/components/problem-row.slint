import { Theme } from "../theme/tokens.slint";
import { ProblemItem } from "../types.slint";
import { Icon, Tag } from "primitives.slint";

export component ProblemRow inherits Rectangle {
    in property <ProblemItem> problem;
    in property <bool> show_activity: false;
    callback clicked(int);
    height: 78px; border-radius: Theme.radius-md; background: area.has-hover ? Theme.surface-hover : Theme.surface;
    border-color: transparent; border-width: 0px;
    HorizontalLayout { padding-left: 16px; padding-right: 15px; spacing: 13px;
        Rectangle { width: 3px; height: 36px; border-radius: 2px; background: root.problem.status == "solved" ? Theme.success : root.problem.status == "in_progress" ? Theme.accent : root.problem.status == "review" ? Theme.warning : Theme.separator; }
        VerticalLayout { spacing: 4px; vertical-stretch: 1;
            HorizontalLayout { spacing: 7px;
                Text { text: root.problem.title; color: Theme.text; font-size: 14px; font-weight: 650; overflow: elide; vertical-stretch: 1; }
                Text { visible: root.problem.identifier != ""; text: root.problem.identifier; color: Theme.text-muted; font-size: 11px; }
            }
                Text { text: root.problem.platform != "" ? root.problem.platform + (root.problem.languages != "" ? "  ·  " + root.problem.languages : "") : root.problem.languages; color: Theme.text-secondary; font-size: 12px; overflow: elide; }
            HorizontalLayout { spacing: 5px;
                Tag { text: root.problem.status_label; ink: root.problem.status == "solved" ? Theme.success : root.problem.status == "in_progress" ? Theme.accent : root.problem.status == "review" ? Theme.warning : Theme.text-muted; fill: root.problem.status == "solved" ? Theme.success-soft : root.problem.status == "in_progress" ? Theme.accent-soft : root.problem.status == "review" ? Theme.warning-soft : Theme.field; width: 82px; }
                Tag { text: root.problem.difficulty_label; ink: Theme.text-secondary; fill: Theme.field; width: 58px; }
                Text { visible: root.problem.tags != ""; text: root.problem.tags; color: Theme.text-muted; font-size: 11px; overflow: elide; vertical-stretch: 1; }
            }
        }
        VerticalLayout { width: 126px; spacing: 8px; alignment: end;
            Text { text: root.show_activity && root.problem.last_opened_at != "" ? root.problem.last_opened_at : root.problem.updated_at; color: Theme.text-muted; font-size: 11px; horizontal-alignment: right; }
            Icon { name: "arrow"; width: 16px; height: 16px; }
        }
    }
    area := TouchArea { clicked => root.clicked(root.problem.id); }
}
